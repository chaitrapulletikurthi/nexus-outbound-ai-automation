# Private values belong in your secrets manager; NEVER commit a filled .env
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DB_NAME
PG_SSL=true
PORT=8080
LISTEN_HOST=127.0.0.1
INTERNAL_API_TOKEN=REPLACE_WITH_LONG_RANDOM_SECRET
WEBHOOK_BEARER_TOKEN=REPLACE_WITH_DIFFERENT_LONG_RANDOM_SECRET
ELIGIBILITY_URL=https://YOUR_PRIVATE_CRM_SERVICE/eligibility
ELIGIBILITY_TOKEN=REPLACE_WITH_PRIVATE_CRM_TOKEN
LISTING_REVIEW_URL=https://YOUR_PRIVATE_REVIEW_SERVICE/verified-listings
LISTING_REVIEW_TOKEN=REPLACE_WITH_PRIVATE_REVIEW_SECRET
VAPI_PRIVATE_KEY=REPLACE_WITH_VAPI_PRIVATE_API_KEY
VAPI_ASSISTANT_ID=REPLACE_WITH_SAVED_ASSISTANT_ID
VAPI_PHONE_NUMBER_ID=REPLACE_WITH_IMPORTED_OUTBOUND_PHONE_ID
ENABLE_LIVE_CALLS=false
LAUNCH_APPROVED=false
POLL_INTERVAL_MS=15000
CRM_ACTION_WEBHOOK_URL=https://YOUR_PRIVATE_CRM_SERVICE/actions
CRM_ACTION_API_TOKEN=REPLACE_WITH_PRIVATE_CRM_ACTION_TOKEN

# Required before enabling calling: private consent evidence and DNC service, approved listing review.

REVIEW_ADMIN_TOKEN=REPLACE_WITH_SEPARATE_REVIEW_ADMIN_TOKEN

# Private Airtable action receiver (optional, not a legal consent verification service)
AIRTABLE_TOKEN=REPLACE_WITH_PRIVATE_AIRTABLE_TOKEN
AIRTABLE_BASE_ID=REPLACE_WITH_PRIVATE_BASE_ID
AIRTABLE_BUYERS_TABLE_ID=REPLACE_WITH_PRIVATE_BUYERS_TABLE_ID
AIRTABLE_ACTIONS_TABLE_ID=REPLACE_WITH_PRIVATE_ACTION_TABLE_ID
AIRTABLE_DNC_FIELD=Do Not Contact
AIRTABLE_ACTION_KEY_FIELD=Action Key
CRM_PORT=8090

# Independent monitor and privacy maintenance
QUEUE_PRIVATE_URL=https://YOUR_PRIVATE_QUEUE_SERVICE
MONITOR_WEBHOOK_URL=
RETENTION_DAYS=180
ENABLE_RETENTION_PURGE=false
PRIVACY_REVIEW_APPROVED=false

# Optional private Airtable buyer summary fields (field names must exist with compatible types)
AIRTABLE_CALLBACK_REQUEST_FIELD=
AIRTABLE_INTEREST_SUMMARY_FIELD=
AIRTABLE_LAST_CALL_STATUS_FIELD=
