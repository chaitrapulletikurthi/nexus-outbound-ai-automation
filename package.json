{
  "name": "outbound-ai-voice-reference",
  "version": "0.5.0",
  "private": true,
  "description": "Sanitized outbound voice architecture, guarded single-call queue and reference integrations",
  "scripts": {
    "test": "node --test tests/*.test.js && node tests/smoke-test.js && node tests/safety-check.js",
    "start": "node src/service.js",
    "crm-sync": "node src/crm-sync.js",
    "crm-receiver": "node src/airtable-crm-receiver.js",
    "monitor": "node src/monitor.js",
    "retention:dry-run": "node src/maintenance.js",
    "retention:apply": "node src/maintenance.js --apply",
    "test:integration": "node --test tests/integration/*.test.js",
    "test:workflow": "node --test tests/integration/exported-workflow.test.js",
    "test:all": "npm test && npm run test:integration"
  },
  "dependencies": {
    "pg": "8.23.1"
  },
  "engines": {
    "node": ">=20"
  }
}
